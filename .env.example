# Where the Express backend runs. The frontend proxies /api/* to it.
BACKEND_URL=http://localhost:3002

# Your live domain, no trailing slash. Used for canonical URLs, sitemap, robots, llms.txt and share images.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Search console verification codes (optional, from Google Search Console / Bing Webmaster Tools)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
